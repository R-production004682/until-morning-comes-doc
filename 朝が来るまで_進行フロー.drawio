        <mxCell id="true" parent="1" vertex="1" value="&lt;div style=&quot;font-size:17px;color:#ffffff;font-weight:700;line-height:1.32;&quot;&gt;True End&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#fff2f4;font-weight:400;line-height:1.32;&quot;&gt;タイトル背景が変化&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Yu Gothic;fillColor=#75102b;strokeColor=#6f0000;fontColor=#ffffff;strokeWidth=1;">
          <mxGeometry x="419" y="1008" width="230" height="65" as="geometry" />
